# ---------------------------------------------------------------------------
# Kamala Infra — environment template
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# Generate every secret below with:
#     openssl rand -base64 48 | tr -d '\r\n'
#
# The `tr -d '\r\n'` matters on Windows: openssl emits CRLF, and stripping only
# '\n' leaves a carriage return inside the quoted value. dotenv trims it, so the
# service runs fine while the file does not contain the secret it is actually
# using — and anything reading the file directly derives a different key.
# Boot-time validation now rejects whitespace in secrets for this reason.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database ---------------------------------------------------------------
# Matches docker-compose.yml. Non-default host ports so this project cannot
# collide with other PostgreSQL/Redis instances already running locally.
POSTGRES_PORT=5442
DATABASE_URL="postgresql://kamala:kamala_dev_password@localhost:5442/kamala?schema=public"

# --- Redis (queues, rate limiting) ------------------------------------------
REDIS_PORT=6382
REDIS_URL="redis://localhost:6382"

# --- API --------------------------------------------------------------------
API_PORT=4000
# Comma-separated allowlist. No wildcards in any deployed environment.
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# --- JWT --------------------------------------------------------------------
# Two DIFFERENT secrets. Rotating one must not invalidate the other's purpose.
JWT_ACCESS_SECRET=3oFQS4bqaZmJMIlcs0StsDRNT9/7MFY98ye/eAXxOxZGya9n70cQLdmj1EMPa7vW
JWT_REFRESH_SECRET=3oFQS4bqaZmJMIlcs0StsDRNT9/7MFY98ye/eAXxOxZGya9n70cQLdmj1EMPa7vW
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# --- Document encryption ----------------------------------------------------
# The single most sensitive secret on the platform. Documents (sale deeds, ID
# proofs) are encrypted with AES-256-GCM in the API *before* upload, so the
# storage provider never holds plaintext.
#
# Must be 32 bytes, base64-encoded:  openssl rand -base64 32
#
# Rotating this requires re-encrypting every stored document — see
# docs/DEPLOYMENT.md before changing it in a live environment.
DOCUMENT_ENCRYPTION_KEY=biS5Yz4hjceq9Oc90tN8shTgrHRLtlVf07+Uu+ORiTc=

# --- Object storage (S3-compatible: DO Spaces / R2 / S3) --------------------
STORAGE_ENDPOINT="https://blr1.digitaloceanspaces.com"
STORAGE_REGION="blr1"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# Two buckets. Public photos are CDN-served; documents are private, never
# fronted by a CDN, and reachable only via short-lived presigned URLs.
STORAGE_BUCKET_PUBLIC="kamala-media-dev"
STORAGE_BUCKET_DOCUMENTS="kamala-documents-dev"
# Presigned URL lifetime for admin document preview, in seconds.
DOCUMENT_URL_TTL_SECONDS=300

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Kamala Infra <no-reply@kamalainfra.example>"
# Base URL used to build links in emails.
APP_PUBLIC_URL="http://localhost:3000"

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000"

# --- Phone OTP delivery -----------------------------------------------------
# "console" logs the code to the API console (dev only — refused in production
# by the env schema). "whatsapp" sends via Meta Cloud API (direct, no BSP);
# switching drivers is a single env change, nothing else in the code changes.
OTP_DELIVERY="console"
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# --- WhatsApp Cloud API (only required when OTP_DELIVERY="whatsapp") --------
# Values come from the Meta Business Suite after the WhatsApp Business Account
# is provisioned. PHONE_NUMBER_ID is Meta's internal id — not the phone number
# digits. TEMPLATE_NAME must be an approved authentication-category template
# (recommended: selleasy24_login_otp).
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_TEMPLATE_NAME="selleasy24_login_otp"
WHATSAPP_TEMPLATE_LANGUAGE="en"

# --- Not used in Batch 1, kept for continuity -------------------------------
# GOOGLE_MAPS_API_KEY=""
