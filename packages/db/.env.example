# Prisma reads this file directly.
#
# The seed scripts run `tsx --env-file=.env`, and Node throws if the file is
# absent — so a fresh clone cannot seed until this is copied to `.env`, which is
# gitignored along with every other .env.
#
#     cp packages/db/.env.example packages/db/.env
#
# Kept separate from the repo-root .env because the Prisma CLI is invoked from
# this directory and does not read the root one. The value should match
# DATABASE_URL there; the port comes from docker-compose.yml.
DATABASE_URL="postgresql://kamala:kamala_dev_password@localhost:5442/kamala?schema=public"
