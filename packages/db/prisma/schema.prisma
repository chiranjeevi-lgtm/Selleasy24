// =============================================================================
// Kamala Infra — database schema (Batch 1)
//
// Design rules that must survive future changes:
//
//  1. Nothing is publicly visible unless a human verifier approved it. Query
//     helpers, not controllers, are the enforcement point.
//  2. `Listing.firstListedAt` is immutable. Bumping or re-approving a listing
//     must never reset it — stale listings masquerading as new is the single
//     most common complaint about incumbent portals.
//  3. Every price change is recorded. Price history cannot be backfilled, so it
//     is captured from day one even though the UI lands later.
//  4. Every document *view* is logged, not just approve/reject decisions.
//  5. Verification checks are rows, not a blob, so the public badge can show
//     exactly what was checked and when.
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // postgis  — reserved for Phase 2 map/radius search
  // pg_trgm  — powers fuzzy address matching for duplicate detection
  extensions = [postgis, pg_trgm]
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

/// Full role set from the PRD permission matrix. Batch 1 exercises BUYER,
/// OWNER, VERIFIER and ADMIN; the rest exist so adding them later is a
/// permission change rather than a migration.
enum Role {
  BUYER
  OWNER
  BROKER
  /// Developer selling new construction. Lists projects with many units rather
  /// than individual resale properties, and is legally required to hold a RERA
  /// project registration before advertising at all.
  BUILDER
  /// SellEasy24-vetted field agent — visits properties, captures photos and
  /// documents, and creates the listing on behalf of an owner who cannot or
  /// will not list themselves. Set on User only after admin activates the
  /// application; the pending state lives on FieldAgent.status.
  FIELD_AGENT
  /// Applicant to the field-agent programme. Has an account (created at
  /// application time so the applicant can log back in to check status) but
  /// no agent-specific permissions until admin activates → role upgrades to
  /// FIELD_AGENT. Only capability: view own pending-application status page.
  AGENT_APPLICANT
  VERIFIER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

/// Lifecycle of a FieldAgent application / active agent record.
///
/// PENDING → applicant submitted the form, awaiting admin review.
/// ACTIVE  → admin activated; the user's Role is FIELD_AGENT and they can
///           see the assistance queue.
/// SUSPENDED → temporarily blocked (dispute pending, low rating). Retains
///             the FieldAgent record and history; can be un-suspended.
/// INACTIVE  → resigned or long-term suspended; not shown in the public
///             agent directory.
enum FieldAgentStatus {
  PENDING
  ACTIVE
  SUSPENDED
  INACTIVE
}

/// Residential only. Land, plots and commercial are explicitly out of scope.
enum PropertyType {
  FLAT
  HOUSE
  APARTMENT
  BUILDING
}

/// A listing is either a sale or a rental. Kept as an enum on Listing (not
/// two models) because the property itself is the same asset — separating
/// would mean duplicate rows for a home the owner is open to selling or
/// renting. Rent-specific columns are nullable and only meaningful when
/// kind = RENT.
enum ListingKind {
  SALE
  RENT
}

/// Rental market conventions in India. Absentee owners routinely restrict
/// to family-only or company-only; bachelors get filtered by gender in
/// most metros. ANY means the owner has no preference.
enum TenantPreference {
  ANY
  FAMILY
  BACHELOR_MALE
  BACHELOR_FEMALE
  COMPANY
}

/// Furnishing, facing, possession and amenities exist as enums rather than free
/// text because the PRD's core complaint is "listings contain inconsistent or
/// incomplete information". Free text cannot be filtered, cannot be compared
/// field-for-field, and cannot be rendered identically on every detail page.
enum FurnishingStatus {
  UNFURNISHED
  SEMI_FURNISHED
  FULLY_FURNISHED
}

enum FacingDirection {
  NORTH
  SOUTH
  EAST
  WEST
  NORTH_EAST
  NORTH_WEST
  SOUTH_EAST
  SOUTH_WEST
}

enum PossessionStatus {
  READY_TO_MOVE
  UNDER_CONSTRUCTION
}

/// Fixed checklist. Adding a value is a migration, which is deliberate — an
/// open-ended amenity list drifts into "24/7 water", "24x7 Water", "Water 24
/// hours" and stops being filterable within a month.
enum Amenity {
  LIFT
  POWER_BACKUP
  SECURITY
  CCTV
  GATED_COMMUNITY
  GYM
  SWIMMING_POOL
  CLUBHOUSE
  CHILDRENS_PLAY_AREA
  PARK
  WATER_SUPPLY_24_7
  BOREWELL
  RAINWATER_HARVESTING
  SOLAR_WATER_HEATER
  INTERCOM
  FIRE_SAFETY
  VISITOR_PARKING
  MAINTENANCE_STAFF
  WASTE_DISPOSAL
  VAASTU_COMPLIANT
}

/// How the seller wants to be reached about this listing. Required by the PRD
/// at listing creation.
enum ContactPreference {
  PHONE
  WHATSAPP
  EMAIL
  ANY
}

/// How the property is held. Power-of-attorney sales carry materially higher
/// title risk in Telangana than a registered freehold, so this is captured as
/// structured data a verification officer can check against the sale deed —
/// not buried in free text where nobody will read it.
enum OwnershipType {
  FREEHOLD
  LEASEHOLD
  CO_OPERATIVE_SOCIETY
  POWER_OF_ATTORNEY
}

/// The authority that sanctioned the building plan. Telangana-specific and a
/// genuine trust signal: GHMC covers the city, HMDA the wider metropolitan
/// area, DTCP the areas outside it.
enum ApprovingAuthority {
  GHMC
  HMDA
  DTCP
  OTHER
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  /// Hidden by the seller, and reversible by them without another review.
  ///
  /// Distinct from ARCHIVED because it comes back. Nothing about the property
  /// changed while it was away, so the documents an officer already checked
  /// still describe it — making a seller re-queue would be a tax on the exact
  /// behaviour we want, which is taking a listing down the moment it stops
  /// being available rather than leaving it up.
  PAUSED
  /// Terminal. The property sold.
  ///
  /// A state of its own rather than ARCHIVED with a note: "sold" is the outcome
  /// this platform exists to produce, it is the only status that can carry a
  /// real transaction price, and conflating it with "withdrawn" would throw
  /// away the one signal that says the marketplace worked.
  SOLD
  ARCHIVED
  SUSPENDED
}

/// Shown on every listing card. Buyers consistently report being misled about
/// whether they are dealing with an owner or an agent.
enum SellerKind {
  OWNER
  BROKER
}

enum DocumentKind {
  SALE_DEED
  ID_PROOF
  PROPERTY_TAX_RECEIPT
  ENCUMBRANCE_CERTIFICATE
  NOC
  APPROVED_PLAN
  RERA_CERTIFICATE
  OCCUPANCY_CERTIFICATE
  COMPLETION_CERTIFICATE
  SOCIETY_NOC
}

/// Deliberately document-type-agnostic. PAN and DigiLocker are the preferred
/// paths; storing full Aadhaar scans carries retention restrictions under
/// Indian law, so it must never be the only option. See docs/ARCHITECTURE.md.
enum IdProofKind {
  PAN
  DIGILOCKER
  AADHAAR_OFFLINE_XML
  AADHAAR_MASKED
  PASSPORT
  VOTER_ID
  DRIVING_LICENCE
}

enum VerificationDecision {
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

/// Each check is displayed publicly on the verified badge. A badge that does
/// not say what was checked is worth less than no badge at all.
enum VerificationCheckKind {
  // --- Resale listings ---
  OWNER_NAME_MATCHES_DEED
  DEED_REGISTERED_AND_STAMPED
  PROPERTY_TAX_CURRENT
  LOCATION_MATCHES_DOCUMENTS
  NO_ENCUMBRANCE_FOUND
  RERA_REGISTERED

  // --- Builder projects ---
  //
  // A separate set because the resale checks are meaningless here: there is no
  // sale deed for a flat that does not exist yet, and no property tax on it.
  // Reusing them would have officers marking half the list "not applicable"
  // every time, which trains them to stop reading it.
  /// The project's RERA registration exists and is current. Advertising an
  /// unregistered project is illegal, so this is the gating check.
  PROJECT_RERA_VALID
  /// Building plan sanctioned by the competent authority (GHMC, HMDA or DTCP).
  PROJECT_PLAN_SANCTIONED
  /// Commencement certificate issued — construction is legally allowed to start.
  PROJECT_COMMENCEMENT_CERTIFICATE
  /// Land title is clear and the builder has the right to develop it.
  PROJECT_LAND_TITLE_CLEAR
  /// Completed projects only: occupancy certificate issued.
  PROJECT_OCCUPANCY_CERTIFICATE
}

/// Where a project sits in its lifecycle.
///
/// A builder's portfolio spans all of these at once, and the distinction is the
/// single most important thing a buyer wants: an unbuilt flat and a delivered
/// one are different purchases carrying different risk.
enum ProjectStage {
  /// Announced, RERA registered, not yet selling.
  PRE_LAUNCH
  UNDER_CONSTRUCTION
  /// Structurally complete, awaiting occupancy certificate.
  NEARING_POSSESSION
  /// Occupancy certificate issued, units available now.
  READY_TO_MOVE
  /// Handed over. Usually no inventory left — kept because a builder's record
  /// of delivering past projects is what a buyer judges the current one on.
  DELIVERED
}

/// Publication state of a project. Mirrors ListingStatus deliberately: the same
/// promise applies, that nothing reaches a buyer before an officer has checked it.
enum ProjectStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
  SUSPENDED
}

/// Why a buyer is buying.
///
/// Deliberately residential only. The platform sells flats and houses in
/// Telangana — there is no commercial inventory, and offering "commercial" as a
/// purpose would collect a preference nothing can satisfy.
///
/// The distinction is not cosmetic: someone buying to live in it weighs schools,
/// commute and possession date, while someone buying to let weighs rental yield
/// and tenant demand. They should not be shown the same ranking.
enum BuyingPurpose {
  /// Buying a home to live in.
  LIVE_IN
  /// Buying to let out.
  RENT_OUT
  /// Buying to hold. Cares about appreciation more than liveability.
  INVESTMENT
}

/// How a buyer earns, which is what a lender asks first.
///
/// An enum rather than free text so it can be filtered and reported on, and so
/// the answer means the same thing for every buyer.
enum Occupation {
  SALARIED
  SELF_EMPLOYED
  BUSINESS_OWNER
  /// Doctor, lawyer, chartered accountant and similar.
  PROFESSIONAL
  RETIRED
  STUDENT
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  NOT_INTERESTED
  CONVERTED
}

/// Where a site-visit request has got to.
///
/// `RESCHEDULED` is the seller proposing a different time rather than refusing
/// outright — the common case when a slot does not suit, and collapsing it into
/// DECLINED would lose a visit that was going to happen.
enum SiteVisitStatus {
  REQUESTED
  CONFIRMED
  RESCHEDULED
  DECLINED
  CANCELLED
  COMPLETED
}

enum ReportReason {
  FAKE_LISTING
  ALREADY_SOLD
  INCORRECT_DETAILS
  DUPLICATE
  SPAM_OR_ABUSE
  OTHER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

// ----------------------------------------------------------------------------
// Identity
// ----------------------------------------------------------------------------

model User {
  id           String  @id @default(uuid()) @db.Uuid
  email        String  @unique
  /// Alternative identifier for sign-in. New signups pick one alongside
  /// their email; existing users are backfilled to null and continue to
  /// sign in with email only. 3–30 chars, lowercased at write, unique.
  username     String? @unique
  /// E.164. Optional at registration, required before a listing may be
  /// submitted for review.
  phone        String? @unique
  fullName     String
  /// argon2id. Never logged, never returned by any serializer.
  passwordHash String

  /// Public officer identifier for VERIFIER accounts (e.g. "V-001").
  /// Rendered on every listing card next to the verification recency
  /// label ("verified 4h ago · V-001") so the check is attributable
  /// rather than anonymous. Cross-Cutting Principle #4 — a defensible
  /// marketing claim that Square Yards' passive badge cannot match.
  /// Nullable for non-verifier accounts.
  officerPublicId String? @unique @db.VarChar(10)

  role Role @default(BUYER)

  /// Set when role is OWNER or BROKER. Drives the Owner/Broker label.
  sellerKind SellerKind?
  /// RERA registration number — mandatory for brokers before listing.
  reraNumber String?

  isEmailVerified Boolean   @default(false)
  isPhoneVerified Boolean   @default(false)
  isActive        Boolean   @default(true)
  /// Populated when an admin suspends the account.
  suspendedAt     DateTime?
  suspendedReason String?

  /// Per-account brute-force protection, complementing the per-IP rate limit.
  /// IP throttling alone does not stop a distributed attack on one account.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  buyerProfile           BuyerProfile?
  savedListings          SavedListing[]
  siteVisitRequests      SiteVisitRequest[]
  builderProjects        Project[]                @relation("BuilderProjects")
  verifiedProjects       Project[]                @relation("VerifierProjects")
  projectDocuments       ProjectDocument[]
  listings               Listing[]                @relation("SellerListings")
  verifiedListings       Listing[]                @relation("VerifierListings")
  uploadedDocuments      Document[]
  documentAccesses       DocumentAccessLog[]
  verifications          Verification[]
  leadsSubmitted         Lead[]
  priceChanges           PriceHistory[]
  reportsFiled           ListingReport[]          @relation("ReporterReports")
  reportsResolved        ListingReport[]          @relation("ResolverReports")
  localityReviews        LocalityReview[]         @relation("AuthorLocalityReviews")
  moderatedLocalityReviews LocalityReview[]       @relation("ModeratorLocalityReviews")
  syncedRegulatoryRegistrations RegulatoryRegistration[] @relation("RegulatorySyncedBy")
  fieldAgentProfile      FieldAgent?              @relation("FieldAgentUser")
  activatedFieldAgents   FieldAgent[]             @relation("FieldAgentActivator")
  suspendedFieldAgents   FieldAgent[]             @relation("FieldAgentSuspender")
  savedSearches          SavedSearch[]
  referralCode           ReferralCode?
  referralsMade          Referral[]               @relation("ReferralReferrer")
  referralRedeemed       Referral?                @relation("ReferralReferred")
  referralRewardsEarned  ReferralReward[]         @relation("RewardRecipient")
  referralRewardsPaid    ReferralReward[]         @relation("RewardPaidBy")
  auditLogs              AuditLog[]
  refreshTokens          RefreshToken[]
  passwordResetTokens    PasswordResetToken[]
  emailVerificationToken EmailVerificationToken[]
  // Written-commitment ledger relations. A user can appear on either side of
  // a commitment (promisor / promisee) and can be the resolver on staff-side.
  commitmentsMade        WrittenCommitment[] @relation("CommitmentPromisor")
  commitmentsReceived    WrittenCommitment[] @relation("CommitmentPromisee")
  commitmentsResolved    WrittenCommitment[] @relation("CommitmentResolver")

  @@index([role])
  @@index([isActive])
  @@map("users")
}

// ----------------------------------------------------------------------------
// Session & token handling
// ----------------------------------------------------------------------------

/// Refresh tokens are stored hashed and rotated on every use. A replayed token
/// that has already been rotated indicates theft — the handler revokes the
/// whole family rather than just rejecting the request.
model RefreshToken {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  tokenHash String @unique

  /// Groups tokens descended from one login, so a detected replay can revoke
  /// the entire lineage.
  familyId String @db.Uuid

  expiresAt      DateTime
  revokedAt      DateTime?
  /// Set when this token is exchanged, making replay detectable.
  rotatedAt      DateTime?
  createdByIp    String?
  createdByAgent String?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// ----------------------------------------------------------------------------
// Location
// ----------------------------------------------------------------------------

/// Fixed reference data, not free text, so search results stay consistent.
/// `city` sits above locality so expansion beyond Hyderabad is a data change.
model Neighborhood {
  id      String @id @default(uuid()) @db.Uuid
  name    String
  city    String
  state   String @default("Telangana")
  pincode String

  /// Cached locality benchmark, recomputed periodically from approved listings.
  /// Surfaced to buyers as "₹X/sqft vs locality median ₹Y" — the incumbents
  /// compute this and hide it behind a paywall.
  medianPricePerSqft Decimal?  @db.Decimal(12, 2)
  medianSampleSize   Int?
  medianComputedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties       Property[]
  projects         Project[]
  preferredByBuyers BuyerPreferredLocality[]
  reviews          LocalityReview[]
  snapshots        LocalitySnapshot[]

  @@unique([name, city, pincode])
  @@index([city])
  @@index([pincode])
  @@map("neighborhoods")
}

/// Regulatory registration records, keyed by the number issued by the
/// authority (RERA in practice — the enum leaves room for HMDA and GHMC
/// too). Populated by an automated sync (Phase 2 nightly job) and manually
/// via the admin console. Verifiers cross-check every listing's declared
/// registration number against this table; a mismatch or an expired
/// registration is what turns the RERA verification check red.
///
/// This is REFERENCE data — one row per external registration, not per
/// listing. The link to Listings and Projects is by matching the
/// `registrationNumber` field to `Listing.reraNumber` (Phase 2 addition
/// on Listing) or `Project.reraNumber` (already present).
enum RegulatoryAuthority {
  TSRERA
  HMDA
  GHMC
}

enum RegulatoryStatus {
  ACTIVE
  EXPIRED
  REVOKED
  UNDER_REVIEW
  NOT_FOUND
}

model RegulatoryRegistration {
  id                 String @id @default(uuid()) @db.Uuid
  authority          RegulatoryAuthority @default(TSRERA)
  registrationNumber String @unique

  /// Everything below is captured from the source portal record.
  projectName  String
  promoterName String
  towerPhases  String? @db.VarChar(500)
  totalUnits   Int?

  registeredOn DateTime  @db.Date
  expiresOn    DateTime? @db.Date
  status       RegulatoryStatus @default(ACTIVE)

  /// Free-form field for anything the officer wants to note that isn't
  /// structured — pending complaints, extension histories, etc.
  approvalNotes String? @db.VarChar(1000)

  /// Provenance. Set to the user who created or last synced this record;
  /// null when the future nightly scraper wrote it.
  syncedById String?  @db.Uuid
  syncedAt   DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  syncedBy User? @relation("RegulatorySyncedBy", fields: [syncedById], references: [id])

  @@index([status])
  @@index([authority, status])
  /// Lookup by registration number is the primary access pattern — the
  /// unique constraint above covers this already.
  @@map("regulatory_registrations")
}

/// Daily analytics snapshot for a locality — one row per locality per day.
///
/// Enables the price-trend charts on locality-overview pages and the
/// insights dashboard (Feature 10) without recomputing over the entire
/// listing history every request. Year-over-year appreciation is computed
/// at read time by joining today's row against the snapshot from N years
/// ago; nothing here needs a materialised view.
///
/// The `unique(neighborhoodId, snapshotDate)` constraint makes the daily
/// job idempotent — running it twice on the same day updates rather than
/// duplicates.
model LocalitySnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  neighborhoodId String   @db.Uuid
  /// Date bucket. One row per locality per day, upserted on recompute.
  snapshotDate   DateTime @db.Date

  /// Median ₹/sqft across APPROVED + verified listings on this date.
  /// Nullable when sample size is below the minimum threshold — a thin
  /// locality with two listings shouldn't feed a "median" that swings
  /// wildly on the next arrival.
  medianPricePerSqft Decimal? @db.Decimal(12, 2)
  /// Total APPROVED + verified listings visible on this date.
  listingCount Int
  /// Number of listings whose price/area fed the median calculation.
  sampleSize Int
  /// Average days between firstListedAt and (soldAt || now) — a velocity
  /// signal. Nullable when there is nothing to average across.
  avgDaysOnMarket Int?

  createdAt DateTime @default(now())

  neighborhood Neighborhood @relation(fields: [neighborhoodId], references: [id], onDelete: Cascade)

  @@unique([neighborhoodId, snapshotDate])
  @@index([neighborhoodId, snapshotDate])
  @@index([snapshotDate])
  @@map("locality_snapshots")
}

/// Locality UGC — residents review the neighbourhood, not any specific
/// listing. Reviews go through moderation before appearing publicly because
/// the whole point of an on-domain reviews surface is to keep trust
/// conversation ours rather than Google's; that only works if the content
/// is not garbage. One review per user per locality is a database
/// constraint, not a runtime check, so a race between two POSTs cannot
/// produce two reviews.
enum LocalityReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Saved search — a named URL-search-parameter snapshot a buyer wants to
/// revisit or (once notifications ship) receive alerts against. Filters
/// are stored as-is from the URL query string, which is the canonical form
/// the search API already consumes — no parallel schema to keep in sync.
///
/// Alerts are a Phase 3 add: the model has `alertsEnabled` and
/// `lastNotifiedAt` columns ready so the future cron only needs to add the
/// send logic. Ships without them so the "save this search" flow can go
/// live now.
model SavedSearch {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  /// Human-readable name the buyer gave the search. Defaults to a
  /// generated summary when the buyer doesn't set one, so the list is
  /// never a wall of "Search 1 / Search 2".
  name String @db.VarChar(120)

  /// Full URL query string that reproduces the search, e.g.
  /// "neighborhoodId=abc&bedrooms=3&maxPrice=15000000". Kept as a string
  /// rather than parsed into columns because the search API's parameter
  /// set changes across phases — coupling the schema to the query shape
  /// would need a migration every time we add a filter.
  queryString String @db.VarChar(2000)

  /// Notification opt-in. When true, the alerts cron includes this search
  /// in its scan. False by default — an opt-in surface, not opt-out.
  alertsEnabled Boolean @default(false)

  /// Last time the alerts cron sent a notification for this search.
  /// Used to dedupe so the same match doesn't notify twice.
  lastNotifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  /// Cron-side query: only searches with alerts on, sorted by oldest
  /// notification (fairness — newest doesn't jump the queue).
  @@index([alertsEnabled, lastNotifiedAt])
  @@map("saved_searches")
}

/// Referral code — one per user, auto-generated on first request. Used
/// as the redemption key when a new signup enters a referral code. Kept
/// separate from Referral so the "generate my code" flow can be
/// idempotent (same user asking twice gets the same code back).
model ReferralCode {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  /// 6–10 character alphanumeric code, uppercase. Case-insensitive on
  /// redemption because typing a mixed-case code is friction the reward
  /// doesn't justify.
  code String @unique @db.VarChar(16)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("referral_codes")
}

/// Referral instance — one row per (referrer, referred) pair, created
/// when a new signup redeems a referral code. Referred user is unique on
/// this table because a person can only be referred once; the referrer
/// can appear many times.
model Referral {
  id           String @id @default(uuid()) @db.Uuid
  referrerId   String @db.Uuid
  referredId   String @unique @db.Uuid

  /// The code used at redemption time. Kept even though it's derivable
  /// from referrerId — future users may change codes and we still want
  /// audit history for how each referral happened.
  code String @db.VarChar(16)

  /// Reward status. PENDING when just created; QUALIFIED once the
  /// referred user completes a qualifying event (first verified listing
  /// for OWNER/BROKER, first enquiry submitted for BUYER); PAID once the
  /// referrer's reward has been credited/paid out.
  ///
  /// Status transitions correspond to ReferralReward rows: qualifying
  /// creates two PENDING rewards (one for each side); admin flips reward
  /// status to PAID separately, and Referral.status becomes PAID only
  /// when both reward rows are PAID.
  status ReferralStatus @default(PENDING)

  /// Signup IP and user agent, captured at redemption time. Feeds the
  /// admin fraud review — sock-puppet farming is detectable when the same
  /// IP redeems the referrer's code multiple times. Nullable because the
  /// redemption endpoint accepted requests before these were captured.
  signupIp        String?
  signupUserAgent String?

  qualifiedAt DateTime?
  paidAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referrer User               @relation("ReferralReferrer", fields: [referrerId], references: [id])
  referred User               @relation("ReferralReferred", fields: [referredId], references: [id], onDelete: Cascade)
  rewards  ReferralReward[]

  @@index([referrerId, status])
  @@index([status, createdAt])
  @@map("referrals")
}

/// Who gets the reward on a given referral row. Both sides earn — the
/// referrer for making the introduction, the referred for the qualifying
/// action they took. Two rewards per Referral, kept as separate rows so
/// each can be paid, voided, or delayed independently (a fraud finding on
/// one side shouldn't void the other's earned reward).
enum RewardRecipientKind {
  REFERRER
  REFERRED
}

/// Reward lifecycle.
///
/// PENDING — created at qualification, awaiting admin review.
/// PAID    — admin has confirmed disbursement (bank transfer, credit
///           applied to future purchase, etc.). Admin records paymentNote.
/// VOIDED  — admin found fraud, chargeback, or the referral is otherwise
///           disqualified. Terminal.
enum RewardStatus {
  PENDING
  PAID
  VOIDED
}

/// One row per (referral, recipient side). Amount denormalised into the
/// row rather than computed on read — reward values may change over time
/// and a paid reward's amount must reflect the rate at qualification,
/// not the current program rate.
model ReferralReward {
  id             String @id @default(uuid()) @db.Uuid
  referralId     String @db.Uuid
  recipientUserId String @db.Uuid
  recipientKind  RewardRecipientKind

  amountRupees Decimal @db.Decimal(10, 2)
  status       RewardStatus @default(PENDING)

  /// Set when admin flips to PAID or VOIDED. paymentNote carries the
  /// transaction reference (bank UTR, credit application id) or the
  /// void reason.
  paidAt      DateTime?
  paidById    String? @db.Uuid
  paymentNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referral      Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  recipient     User     @relation("RewardRecipient", fields: [recipientUserId], references: [id])
  paidBy        User?    @relation("RewardPaidBy", fields: [paidById], references: [id])

  // One reward per side per referral — enforces "REFERRER row exists at
  // most once" and same for REFERRED. A duplicate is a coding bug.
  @@unique([referralId, recipientKind])
  @@index([recipientUserId, status])
  @@index([status, createdAt])
  @@map("referral_rewards")
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  PAID
  VOIDED
}

/// SellEasy24 Field Agent — professional profile for a user who assists
/// owners with the listing process. An owner who cannot or will not list
/// their own property can request an agent; the agent visits the property,
/// captures photos and documents, and submits the listing on the owner's
/// behalf.
///
/// The record is created when an applicant submits the /become-an-agent
/// form. It stays in PENDING until admin activates. On activation, the
/// linked User.role is set to FIELD_AGENT (both are needed — status gates
/// visibility, role gates route access).
///
/// userId is nullable because an application can come in from someone who
/// does not yet have a SellEasy24 account. Admin either invites them to
/// create one and links, or rejects the application.
model FieldAgent {
  id     String  @id @default(uuid()) @db.Uuid
  userId String? @unique @db.Uuid

  /// Denormalised so the admin queue can list applicants without joining
  /// User (and so applications without a User yet still surface names).
  fullName String  @db.VarChar(120)
  phone    String  @db.VarChar(20)
  email    String  @db.VarChar(255)

  /// Enum-ish free text captured from the form: none / 1-2 / 3-5 / 5+
  /// Not modelled as an enum because the values are display-only and the
  /// applicant's own statement matters more than a rigid category.
  experience String @db.VarChar(20)

  /// Postgres text array of neighborhood names the agent can service.
  /// String array rather than FK to neighborhoods deliberately — service
  /// areas change over time and the admin should not need a migration to
  /// add a new locality to the referenceable list.
  serviceLocalities String[]

  /// Free-form intro / anything else the applicant wanted to say.
  notes String? @db.VarChar(1000)

  status FieldAgentStatus @default(PENDING)

  /// Admin action metadata.
  activatedAt     DateTime?
  activatedById   String?   @db.Uuid
  suspendedAt     DateTime?
  suspendedById   String?   @db.Uuid
  suspendedReason String?   @db.VarChar(500)

  /// Rating aggregate — recomputed when a new owner rates the agent.
  ratingAverage Decimal? @db.Decimal(3, 2)
  ratingCount   Int      @default(0)

  /// Count of assignments completed successfully.
  completedAssignments Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User? @relation("FieldAgentUser", fields: [userId], references: [id], onDelete: SetNull)
  activatedBy User? @relation("FieldAgentActivator", fields: [activatedById], references: [id])
  suspendedBy User? @relation("FieldAgentSuspender", fields: [suspendedById], references: [id])

  /// Queue query: pending applications sorted by oldest first for FIFO
  /// admin processing.
  @@index([status, createdAt])
  /// Directory query: only ACTIVE agents shown publicly.
  @@index([status])
  @@map("field_agents")
}

model LocalityReview {
  id             String @id @default(uuid()) @db.Uuid
  neighborhoodId String @db.Uuid
  authorId       String @db.Uuid

  /// 1–5, enforced by a CHECK constraint in the migration.
  rating Int

  /// Kept as separate short fields rather than one long text — a pros / cons
  /// split renders as a scannable list on the locality page instead of a
  /// wall of prose nobody reads.
  pros String @db.VarChar(500)
  cons String @db.VarChar(500)

  /// Optional. Buyers weigh a "lived here 8 years" review differently from
  /// "moved in last month" — surfaced next to the rating.
  tenureYears Int?

  status         LocalityReviewStatus @default(PENDING)
  moderatedById  String?              @db.Uuid
  moderatedAt    DateTime?
  moderationNote String?              @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  neighborhood Neighborhood @relation(fields: [neighborhoodId], references: [id], onDelete: Cascade)
  author       User         @relation("AuthorLocalityReviews", fields: [authorId], references: [id], onDelete: Cascade)
  moderatedBy  User?        @relation("ModeratorLocalityReviews", fields: [moderatedById], references: [id])

  /// One review per user per locality. A user who changes their mind edits
  /// their existing review rather than posting a new one.
  @@unique([authorId, neighborhoodId])
  /// Public list — the most common query, filters by locality + APPROVED.
  @@index([neighborhoodId, status, createdAt])
  /// Moderation queue — pending across the site, oldest first.
  @@index([status, createdAt])
  @@map("locality_reviews")
}

/// What a buyer told us they are looking for.
///
/// Collected over several short steps after registration rather than in one
/// long form, and every step is skippable. A buyer who abandons partway leaves
/// a partial row here, which is deliberate — half a preference still improves
/// what we show them, and demanding all of it up front loses the account
/// entirely.
///
/// Every field is nullable for the same reason. `completedAt` records whether
/// they reached the end, so we can tell "chose not to answer" from "never got
/// that far".
model BuyerProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  purpose BuyingPurpose?

  /// How many people will live there. Drives the suggested bedroom count, which
  /// the buyer can then override — a couple planning a family and a couple who
  /// are not want different things from the same household size.
  householdSize  Int?
  bedroomsWanted Int?

  /// Rupees. The figures a buyer gives are what recommendations rank against.
  budgetMin Decimal? @db.Decimal(14, 2)
  budgetMax Decimal? @db.Decimal(14, 2)

  occupation Occupation?

  /// Monthly income, in rupees. Optional and asked last, with a stated reason.
  ///
  /// This is financial personal data under the DPDPA and is not needed to rank
  /// properties — budget already carries that signal. It exists only to say
  /// what a bank is likely to lend, so it must never become a precondition for
  /// using the platform, and it is never shown to a seller.
  monthlyIncome Decimal? @db.Decimal(12, 2)

  /// Set when the buyer reaches the end of the steps. Null means they skipped
  /// out partway, which is a different thing from having no preferences.
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  localities BuyerPreferredLocality[]

  @@map("buyer_profiles")
}

/// Localities a buyer wants to be in.
///
/// A join table rather than an array of ids: the localities are fixed reference
/// data with their own rows, and a foreign key means a preference cannot point
/// at a locality that does not exist.
model BuyerPreferredLocality {
  buyerProfileId String @db.Uuid
  neighborhoodId String @db.Uuid

  createdAt DateTime @default(now())

  buyerProfile BuyerProfile @relation(fields: [buyerProfileId], references: [id], onDelete: Cascade)
  neighborhood Neighborhood @relation(fields: [neighborhoodId], references: [id], onDelete: Cascade)

  @@id([buyerProfileId, neighborhoodId])
  @@index([neighborhoodId])
  @@map("buyer_preferred_localities")
}

// ----------------------------------------------------------------------------
// Property & listing
//
// A Property is the physical asset; a Listing is one attempt to sell it. The
// split lets the same flat be relisted later without losing its history.
// ----------------------------------------------------------------------------

model Property {
  id      String @id @default(uuid()) @db.Uuid
  address String
  pincode String

  /// Nullable in Batch 1 — map search is Phase 2. PostGIS is already enabled
  /// so adding a geography column later needs no extension change.
  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)

  propertyType PropertyType
  bedrooms     Int
  bathrooms    Int
  /// Built-up area — the figure Indian listings quote by default.
  areaSqft     Int
  /// Carpet area, the usable floor space. RERA requires it to be disclosed and
  /// it is typically 30% smaller than built-up, so quoting only built-up is the
  /// most common way a price per sq ft is made to look better than it is.
  /// Optional because older resale sellers frequently do not know it.
  carpetAreaSqft Int?
  balconies      Int?
  yearBuilt      Int?

  /// Which floor the unit is on. Null for an independent house, and null when
  /// the seller has not said — the PRD lists floor as optional at creation.
  /// `floor` may legitimately be 0 (ground) or negative (basement), so a
  /// missing value must be null rather than 0.
  floor       Int?
  totalFloors Int?

  /// Possession is required: a buyer filtering for "ready to move" gets a
  /// misleading result set if half the inventory has no value. Every seller
  /// knows this about their own property, so there is no reason to allow null.
  possession PossessionStatus

  furnishing FurnishingStatus?
  facing     FacingDirection?

  /// Nullable, not defaulted to 0 — "no covered parking" and "seller did not
  /// say" are different facts, and a buyer filtering on parking must not be
  /// shown listings that simply left it blank.
  coveredParking Int?
  openParking    Int?

  /// Title and sanction. Both are optional at listing time but are exactly what
  /// a verification officer compares against the sale deed and approved plan,
  /// so capturing them structurally is what lets the check be recorded rather
  /// than described.
  ownership          OwnershipType?
  approvingAuthority ApprovingAuthority?

  /// Postgres enum array. Queried with `has` / `hasEvery`, backed by the GIN
  /// index below so amenity filters do not degrade into sequential scans.
  ///
  /// The empty-array default is declared here as well as in the database.
  /// Prisma omits column defaults for scalar lists by default, which leaves the
  /// database default looking like drift on every future `migrate diff`.
  amenities Amenity[] @default([])

  neighborhoodId String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  neighborhood Neighborhood @relation(fields: [neighborhoodId], references: [id])
  listings     Listing[]

  @@index([neighborhoodId])
  @@index([propertyType])
  @@index([bedrooms])
  @@index([pincode])
  @@index([possession])
  @@index([furnishing])
  @@index([approvingAuthority])
  @@index([ownership])
  /// GIN over the amenity array so `amenities has X` is an index lookup.
  @@index([amenities], type: Gin)
  /// Trigram index powering fuzzy address matching for duplicate detection.
  /// Declared here rather than only in raw SQL because Prisma CAN introspect a
  /// plain-column GIN index — leaving it out of the schema makes every future
  /// `migrate diff` try to drop it.
  ///
  /// The partial and expression indexes in 20260730000100_search_indexes are NOT
  /// expressible in Prisma's schema language. Prisma cannot introspect those, so
  /// they do not appear as drift — but any generated migration must still be
  /// read before it is applied.
  @@index([address(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("properties")
}

model Listing {
  id         String @id @default(uuid()) @db.Uuid
  propertyId String @db.Uuid
  sellerId   String @db.Uuid

  title       String
  description String
  price       Decimal @db.Decimal(14, 2)

  priceNegotiable Boolean @default(false)

  /// SALE (default) or RENT. Rent listings render, filter and sort on
  /// monthlyRent + deposit rather than `price`; the `price` field on a
  /// rental is the notional asking price of the property (informational
  /// only, never shown as the rent).
  kind ListingKind @default(SALE)

  /// Monthly rent in ₹. Required at API level when kind = RENT.
  monthlyRent Decimal? @db.Decimal(10, 2)

  /// Security deposit in "months of rent" — the unit Indian owners
  /// quote in. 1/2/3/6/10 are common. Actual rupee amount = monthlyRent
  /// × depositMonths; not denormalised because monthlyRent changes.
  depositMonths Int?

  /// Who the owner is willing to rent to (Indian rental market convention).
  tenantPreference TenantPreference?

  /// Rental extras — nullable when owner hasn't stated a policy.
  petsAllowed         Boolean?
  availableFrom       DateTime?
  leaseDurationMonths Int?

  /// Marketing signal — Square Yards' "Zero-Deposit Rentals" is the
  /// direct parity. Owner marks the listing zero-brokerage; buyer can
  /// filter on it. Only meaningful for rentals but kept unconditional
  /// so it can be applied to sale listings too if we ever monetise
  /// brokerage differently.
  zeroBrokerage Boolean @default(false)

  /// Sits on the listing rather than the user: a seller may be happy to take
  /// calls about one property and want email only about another.
  contactPreference ContactPreference @default(ANY)

  status ListingStatus @default(DRAFT)

  /// Denormalised from the latest approval so public queries stay single-table.
  isVerified Boolean @default(false)

  /// 0-100 investment score, computed by ScoringService from RERA status,
  /// locality trends, developer track record, infrastructure proximity,
  /// amenities, price vs median, and photo/document completeness. Nullable
  /// because a fresh listing has not been scored yet — scoring runs on
  /// verification approval and via the nightly batch.
  investmentScore            Int?
  investmentScoreComputedAt  DateTime?

  /// IMMUTABLE. Set once when the listing first becomes publicly visible and
  /// never touched again — not on edit, not on re-approval, not on any bump.
  /// This is what makes "listed 3 days ago" honest.
  firstListedAt DateTime?

  /// Last time the seller affirmed the property is still available. Drives the
  /// "Owner confirmed available N days ago" signal and, in Batch 2, the
  /// auto-hide sweep for unconfirmed listings.
  lastConfirmedAt DateTime?

  submittedAt  DateTime?
  verifiedAt   DateTime?
  verifiedById String?   @db.Uuid

  /// Shown to the seller only. Never exposed on a public endpoint.
  rejectionReason String?
  revisionNote    String?

  /// When the seller reported the sale. Only ever set alongside status SOLD.
  soldAt DateTime?

  /// What it actually sold for, if the seller chose to say.
  ///
  /// Optional, and asked for one reason: every price on this platform is an
  /// asking price, and a locality median built from asking prices measures what
  /// sellers hope for rather than what homes are worth. Nobody is required to
  /// answer, and it is never shown against their listing.
  soldPrice Decimal? @db.Decimal(14, 2)

  /// Whether the buyer came from here. The honest measure of whether the
  /// platform did its job, and unknowable unless we ask.
  soldThroughPlatform Boolean?

  /// Why the seller paused it. Shown back to them, never to a buyer.
  pausedReason String?

  /// Counters are denormalised for read performance. ListingView and Lead are
  /// the sources of truth.
  viewsCount Int @default(0)
  leadsCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property      Property        @relation(fields: [propertyId], references: [id])
  seller        User            @relation("SellerListings", fields: [sellerId], references: [id])
  verifiedBy    User?           @relation("VerifierListings", fields: [verifiedById], references: [id])
  photos        ListingPhoto[]
  documents     Document[]
  verifications Verification[]
  leads         Lead[]
  priceHistory  PriceHistory[]
  views         ListingView[]
  reports       ListingReport[]
  siteVisits    SiteVisitRequest[]
  savedBy       SavedListing[]

  // Composite index matching the public search path: approved listings,
  // newest first.
  @@index([status, firstListedAt])
  @@index([sellerId, status])
  @@index([propertyId])
  @@index([price])
  @@index([submittedAt])
  @@map("listings")
}

model ListingPhoto {
  id        String @id @default(uuid()) @db.Uuid
  listingId String @db.Uuid

  /// Object key in the public media bucket. Never a full URL — the CDN host
  /// is environment-specific.
  storageKey String
  sortOrder  Int    @default(0)
  width      Int?
  height     Int?
  sizeBytes  Int?

  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder])
  @@map("listing_photos")
}

/// Append-only. Every price change writes a row, enabling "reduced from ₹85L".
/// Cannot be reconstructed after the fact, which is why it exists in Batch 1
/// even though the UI ships later.
model PriceHistory {
  id            String   @id @default(uuid()) @db.Uuid
  listingId     String   @db.Uuid
  price         Decimal  @db.Decimal(14, 2)
  /// Null for the initial price at creation.
  previousPrice Decimal? @db.Decimal(14, 2)
  changedById   String?  @db.Uuid
  changedAt     DateTime @default(now())

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  changedBy User?   @relation(fields: [changedById], references: [id])

  @@index([listingId, changedAt])
  @@map("price_history")
}

/// One row per unique viewer per day, so `Listing.viewsCount` means something.
/// `sessionHash` is a salted hash of the session identifier — never a raw IP,
/// which would be storing personal data we have no need for.
model ListingView {
  id          String   @id @default(uuid()) @db.Uuid
  listingId   String   @db.Uuid
  sessionHash String
  /// Date bucket enabling the per-day uniqueness constraint below.
  viewedOn    DateTime @db.Date
  viewedAt    DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, sessionHash, viewedOn])
  @@index([listingId])
  @@map("listing_views")
}

// ----------------------------------------------------------------------------
// Builder projects
//
// A project is a development — a tower or gated community — containing many
// units across configurations. Deliberately separate from Listing rather than a
// flag on it: a resale listing is one specific property with one price and one
// owner, while a project has a price *range*, unsold inventory, a possession
// date and no owner yet. Forcing both through one table would mean half the
// columns being null for whichever kind it was not.
// ----------------------------------------------------------------------------

model Project {
  id        String @id @default(uuid()) @db.Uuid
  builderId String @db.Uuid

  name        String
  description String

  // --- Location ---
  address        String
  pincode        String
  neighborhoodId String @db.Uuid

  // --- Lifecycle ---
  stage ProjectStage

  /// Expected handover for anything unfinished; the actual date once delivered.
  /// Stored as a date rather than a quarter string so it can be sorted and
  /// compared — "Q4 2027" cannot.
  possessionDate DateTime?
  /// Set when the project was actually handed over. Kept apart from
  /// `possessionDate` on purpose: the gap between promised and actual delivery
  /// is exactly the track record a buyer is trying to judge, and overwriting one
  /// with the other would erase it.
  deliveredOn    DateTime?

  // --- Statutory ---
  /// RERA project registration. Not optional: advertising an unregistered
  /// project is illegal in Telangana, so a project cannot even be submitted
  /// without one.
  reraNumber         String
  approvingAuthority ApprovingAuthority?

  // --- Scale ---
  totalTowers Int?
  totalUnits  Int?
  /// Land area in acres, the unit Indian project listings quote.
  landAreaAcres Decimal? @db.Decimal(8, 2)

  amenities Amenity[] @default([])

  // --- Publication ---
  status     ProjectStatus @default(DRAFT)
  isVerified Boolean       @default(false)

  /// Investment score 0-100, computed by ScoringService. Weighted heavier
  /// toward RERA + builder track record on projects than on listings
  /// (projects are pre-construction commitments, so delivery history is
  /// the dominant risk signal).
  investmentScore            Int?
  investmentScoreComputedAt  DateTime?

  /// IMMUTABLE once set, exactly as on Listing. A project re-approved after an
  /// edit must not appear newly launched.
  firstListedAt DateTime?

  submittedAt  DateTime?
  verifiedAt   DateTime?
  verifiedById String?   @db.Uuid

  rejectionReason String?
  revisionNote    String?

  viewsCount Int @default(0)
  leadsCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  builder      User              @relation("BuilderProjects", fields: [builderId], references: [id])
  verifiedBy   User?             @relation("VerifierProjects", fields: [verifiedById], references: [id])
  neighborhood Neighborhood      @relation(fields: [neighborhoodId], references: [id])
  units         ProjectUnit[]
  photos        ProjectPhoto[]
  documents     ProjectDocument[]
  verifications Verification[]
  views         ProjectView[]
  leads         Lead[]

  @@index([status, firstListedAt])
  @@index([builderId, status])
  @@index([neighborhoodId])
  @@index([stage])
  @@map("projects")
}

/// One configuration within a project — "3 BHK, 1,650 sq ft, from ₹1.4 Cr".
///
/// Price is a starting figure, not an asking price: units differ by floor,
/// facing and view, and a builder quotes "from". Calling the column `priceFrom`
/// rather than `price` keeps that honest wherever it is rendered.
model ProjectUnit {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid

  bedrooms  Int
  bathrooms Int
  balconies Int?

  areaSqft       Int
  carpetAreaSqft Int?

  priceFrom Decimal @db.Decimal(14, 2)

  /// How many of this configuration exist, and how many remain unsold. A
  /// delivered project usually has zero available and is shown as track record.
  totalUnits     Int?
  availableUnits Int?

  /// Floor plan image, in the public bucket.
  floorPlanKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Enquiries that named this configuration. `SetNull` rather than cascade —
  /// a builder reworking their unit mix must not delete the enquiries it drew.
  leads   Lead[]

  @@index([projectId])
  @@index([bedrooms])
  @@index([priceFrom])
  @@map("project_units")
}

/// One row per unique viewer per day, so `Project.viewsCount` means something.
///
/// Exists for the same reason ListingView does. Without it a builder's dashboard
/// would show a figure anyone could inflate by refreshing, which is worse than
/// showing no figure — the whole point of the dashboard is a number the builder
/// can act on.
model ProjectView {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  sessionHash String
  viewedOn    DateTime @db.Date
  viewedAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sessionHash, viewedOn])
  @@index([projectId])
  @@map("project_views")
}

model ProjectPhoto {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid

  storageKey String
  sortOrder  Int    @default(0)
  /// Elevation render, site progress photograph, clubhouse, and so on. Buyers
  /// treat a render and a real construction photograph very differently, so the
  /// distinction is recorded rather than left to the caption.
  isRender   Boolean @default(false)

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
  @@map("project_photos")
}

/// Statutory documents for a project. Encrypted at rest exactly like the
/// ownership documents on a resale listing, and readable only by staff.
model ProjectDocument {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid

  kind DocumentKind

  storageKey       String
  originalFilename String
  mimeType         String
  sizeBytes        Int

  encryptionIv  String
  encryptionTag String

  uploadedById String    @db.Uuid
  /// Set once a decision has been made; a sweep destroys the bytes afterwards.
  /// Same DPDPA minimisation rule as resale ownership documents.
  retainUntil  DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation(fields: [uploadedById], references: [id])
  accessLogs DocumentAccessLog[]

  @@index([projectId])
  @@map("project_documents")
}

/// A buyer asking to see a property in person.
///
/// `buyerId` is required, unlike on Lead. Arranging to meet a stranger at a
/// property is a real-world commitment on both sides, so both parties are
/// accounts rather than one being an anonymous phone number.
model SiteVisitRequest {
  id        String @id @default(uuid()) @db.Uuid
  listingId String @db.Uuid
  buyerId   String @db.Uuid

  /// What the buyer asked for.
  preferredAt DateTime
  /// The seller's counter-proposal, when the requested slot does not suit.
  proposedAt  DateTime?
  /// The slot both sides settled on. Kept separate from the two above so the
  /// negotiation remains readable after the fact.
  confirmedAt DateTime?

  status SiteVisitStatus @default(REQUESTED)

  /// From the buyer when requesting.
  note       String?
  /// From the seller when responding. Shown to the buyer.
  sellerNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer   User    @relation(fields: [buyerId], references: [id])

  /// The seller's inbox, newest first.
  @@index([listingId, createdAt])
  /// The buyer's own list of requests.
  @@index([buyerId, createdAt])
  @@map("site_visit_requests")
}

/// One-time codes for phone verification.
///
/// The code itself is never stored — only a hash, exactly like a password. An
/// OTP is a credential for the few minutes it lives, and a leaked database
/// dump should not let anyone replay one.
///
/// `attempts` is what stops a six-digit code being brute-forced: a million
/// guesses is minutes of scripted work, so the row is burned after a handful of
/// wrong answers rather than relying on rate limiting alone.
model PhoneVerification {
  id        String @id @default(uuid()) @db.Uuid
  /// E.164. Not a user relation — a phone is verified before the account it
  /// will belong to necessarily exists.
  phone     String
  codeHash  String

  attempts  Int      @default(0)
  expiresAt DateTime
  /// Set when the code is successfully used, so it cannot be replayed.
  consumedAt DateTime?
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
  @@index([expiresAt])
  @@map("phone_verifications")
}

/// A buyer's shortlist.
///
/// Server-side rather than in browser storage because the PRD requires the list
/// to persist "across sessions and devices" — someone who shortlists on their
/// phone during a commute expects to find it on their laptop that evening.
///
/// Deliberately has no `deletedAt`: unsaving is not an event anyone needs a
/// record of, and keeping tombstones of what a buyer briefly considered would
/// be collecting personal data with no purpose.
model SavedListing {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  listingId String   @db.Uuid
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  /// Saving twice is the same as saving once. The unique constraint makes the
  /// save endpoint idempotent at the database level rather than relying on the
  /// application to check first, which would race under a double-click.
  @@unique([userId, listingId])
  /// Serves the shortlist query directly: one user's saves, newest first.
  @@index([userId, createdAt])
  @@index([listingId])
  @@map("saved_listings")
}

// ----------------------------------------------------------------------------
// Documents
//
// The highest-risk data on the platform. Encrypted by the API before upload so
// the storage provider never holds plaintext; served only through short-lived
// presigned URLs; every access logged.
// ----------------------------------------------------------------------------

model Document {
  id           String @id @default(uuid()) @db.Uuid
  listingId    String @db.Uuid
  uploadedById String @db.Uuid

  kind        DocumentKind
  /// Set only when kind is ID_PROOF.
  idProofKind IdProofKind?

  /// Object key in the PRIVATE documents bucket. Never CDN-fronted.
  storageKey String @unique

  /// AES-256-GCM parameters. The key itself lives in the secrets manager, never
  /// in this table.
  encryptionIv  String
  encryptionTag String

  originalFilename String
  mimeType         String
  sizeBytes        Int

  /// DPDPA data minimisation: documents are deleted after the verification
  /// decision plus a dispute window. The decision and audit trail are retained
  /// permanently; the document is not.
  retainUntil DateTime?
  deletedAt   DateTime?

  createdAt DateTime @default(now())

  listing    Listing             @relation(fields: [listingId], references: [id], onDelete: Cascade)
  uploadedBy User                @relation(fields: [uploadedById], references: [id])
  accesses   DocumentAccessLog[]

  @@index([listingId])
  @@index([uploadedById])
  @@index([retainUntil])
  @@map("documents")
}

/// Written on every read of a document, including previews. Answers "who looked
/// at this person's ID proof, and when".
/// Who read which document, and when.
///
/// Polymorphic over the two document tables, exactly as Verification is over
/// listings and projects: a staff member reading a builder's land title needs
/// the same forensic record as one reading a homeowner's sale deed, and a second
/// log table would mean every "who accessed this person's documents" query had
/// to remember to union both.
///
/// Exactly one of the two id columns is set, enforced by a CHECK constraint that
/// Prisma cannot express — see the migration.
model DocumentAccessLog {
  id                String  @id @default(uuid()) @db.Uuid
  documentId        String? @db.Uuid
  projectDocumentId String? @db.Uuid
  userId            String  @db.Uuid

  ipAddress  String?
  userAgent  String?
  accessedAt DateTime @default(now())

  document        Document?        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  projectDocument ProjectDocument? @relation(fields: [projectDocumentId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id])

  @@index([documentId, accessedAt])
  @@index([projectDocumentId, accessedAt])
  @@index([userId])
  @@map("document_access_logs")
}

// ----------------------------------------------------------------------------
// Verification
// ----------------------------------------------------------------------------

/// A verification decision against either a resale listing or a builder project.
///
/// One table rather than two, with exactly one of `listingId` / `projectId` set
/// — enforced by a CHECK constraint in the migration, not just by convention.
/// An officer's history and the audit trail stay in one place, and a second
/// near-identical table would have meant duplicating VerificationCheckResult
/// alongside it.
model Verification {
  id         String  @id @default(uuid()) @db.Uuid
  listingId  String? @db.Uuid
  projectId  String? @db.Uuid
  verifierId String  @db.Uuid

  decision VerificationDecision

  /// Mandatory for REJECTED and REVISION_REQUESTED; enforced in the service
  /// layer. Shown to the seller.
  reason        String?
  /// Never leaves the admin surface.
  internalNotes String?

  createdAt DateTime @default(now())

  listing  Listing?                  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  project  Project?                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  verifier User                      @relation(fields: [verifierId], references: [id])
  checks   VerificationCheckResult[]

  @@index([listingId, createdAt])
  @@index([projectId, createdAt])
  @@index([verifierId])
  @@map("verifications")
}

/// The public checklist. Rows rather than a JSON blob so buyers can be shown
/// precisely which checks passed, and when — with no login required.
model VerificationCheckResult {
  id             String @id @default(uuid()) @db.Uuid
  verificationId String @db.Uuid

  kind   VerificationCheckKind
  passed Boolean
  /// Optional public-safe note, e.g. "EC not required for this property type".
  note   String?

  verification Verification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@unique([verificationId, kind])
  @@map("verification_check_results")
}

// ----------------------------------------------------------------------------
// Leads
//
// A buyer's phone number is visible ONLY to the seller of the listing they
// contacted. It is never bulk-exported, never shared with other sellers, and
// never sold. This is the platform's core promise.
// ----------------------------------------------------------------------------

/// A buyer getting in touch, about either a resale listing or a builder project.
///
/// Polymorphic over the two, exactly as Verification and DocumentAccessLog
/// already are. A second `project_leads` table was the alternative and would
/// have meant every "how many enquiries" query remembering to union both — the
/// kind of omission that silently under-reports for months.
///
/// Exactly one of the two id columns is set, enforced by a CHECK constraint
/// Prisma cannot express. See the migration.
model Lead {
  id        String  @id @default(uuid()) @db.Uuid
  listingId String? @db.Uuid
  projectId String? @db.Uuid
  /// Which configuration they asked about, when it was a project.
  ///
  /// A project sells several at once, and "someone enquired" is far less useful
  /// to a builder than "someone enquired about the 3 BHK" — it is the first
  /// thing their sales team would ask.
  projectUnitId String? @db.Uuid

  /// Null when submitted without an account — low-friction capture is a
  /// deliberate requirement.
  buyerId   String? @db.Uuid

  name    String
  phone   String
  email   String?
  message String?

  status      LeadStatus @default(NEW)
  contactedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing     Listing?     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectUnit ProjectUnit? @relation(fields: [projectUnitId], references: [id], onDelete: SetNull)
  buyer       User?        @relation(fields: [buyerId], references: [id])

  @@index([listingId, createdAt])
  @@index([projectId, createdAt])
  @@index([buyerId])
  @@index([status])
  @@map("leads")
}

// ----------------------------------------------------------------------------
// Reports
//
// Every incumbent is criticised for unreachable support and complaints that
// vanish. Reports are tickets with a status the reporter can see.
// ----------------------------------------------------------------------------

model ListingReport {
  id         String  @id @default(uuid()) @db.Uuid
  listingId  String  @db.Uuid
  reporterId String? @db.Uuid

  reason  ReportReason
  details String?

  status         ReportStatus @default(OPEN)
  resolutionNote String?
  resolvedById   String?      @db.Uuid
  resolvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing    Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporter   User?   @relation("ReporterReports", fields: [reporterId], references: [id])
  resolvedBy User?   @relation("ResolverReports", fields: [resolvedById], references: [id])

  @@index([listingId])
  @@index([status, createdAt])
  @@map("listing_reports")
}

// ----------------------------------------------------------------------------
// Audit
// ----------------------------------------------------------------------------

/// Append-only business record, distinct from application logs and retained
/// independently of log retention. There is no update or delete path.
model AuditLog {
  id      String  @id @default(uuid()) @db.Uuid
  /// Null for system-initiated actions.
  actorId String? @db.Uuid

  /// Stable machine-readable verb, e.g. "listing.approved".
  action     String
  entityType String
  entityId   String

  metadata Json?

  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ----------------------------------------------------------------------------
// Written commitments — Cross-Cutting Principle #1 realised in the schema.
//
// Every discount, cashback, refund, callback, or service promise made on or
// through SellEasy24 is recorded here as an append-only row before it takes
// effect. Verbal promises are invalid by design; a Square Yards-style
// "₹50,000 cashback" that never survives to writing has no record here and,
// per policy, no standing.
//
// Append-only: correcting a commitment writes a new row and sets the old
// row's `supersededById`. A "delete" is a `supersede` with reason. The
// ledger is a legal instrument and the audit path must be reconstructible.
//
// Optional linkage: a commitment may attach to a listing (a price hold),
// a lead (a callback promise made in an enquiry thread), or stand alone
// (a service tier promise made at plan sign-up). All three fields nullable
// so the row itself is the source of truth regardless of the surface that
// created it.
// ----------------------------------------------------------------------------

/// Category of promise, driving both surface rendering and admin reporting.
///
/// DISCOUNT / CASHBACK / REFUND all carry a rupee `amount`; the others may
/// be qualitative (a callback commitment doesn't have a rupee value). The
/// enum is deliberately small — a wider taxonomy would push callers into
/// picking the "least wrong" label instead of the exact one.
enum CommitmentType {
  DISCOUNT
  CASHBACK
  REFUND
  CALLBACK
  SERVICE_PROMISE
  /// Owner or broker holds the asking price for a defined window while a
  /// buyer completes finance / inspection.
  PRICE_HOLD
  OTHER
}

/// Lifecycle of a commitment. Append-only means transitioning between these
/// is done by writing a new WrittenCommitment row that points back at the
/// prior via `supersededById`, then the prior row's `status` is updated to
/// SUPERSEDED. HONORED and DISPUTED are terminal.
enum CommitmentStatus {
  ACTIVE
  HONORED
  SUPERSEDED
  EXPIRED
  DISPUTED
}

model WrittenCommitment {
  id String @id @default(uuid()) @db.Uuid

  /// Who made the promise (SellEasy24 staff account for platform promises;
  /// an owner or broker for listing-level promises).
  promisorId String @db.Uuid
  /// Who the promise runs to (typically a buyer).
  promiseeId String @db.Uuid

  /// Optional attachment to the surface that generated the commitment.
  /// A commitment can be listing-scoped (price hold), lead-scoped (callback
  /// during enquiry), or free-standing (service tier promise at plan
  /// signup). Only one of listingId / leadId is expected to be set, but
  /// both nullable rather than a CHECK — the schema tolerates a commitment
  /// that references both when that is truly the case (e.g. a price hold
  /// attached to a specific enquiry).
  listingId String? @db.Uuid
  leadId    String? @db.Uuid

  type   CommitmentType
  status CommitmentStatus @default(ACTIVE)

  /// The promise itself, written out in plain language for both parties
  /// and the record. This is the text that appears on the signed PDF.
  promiseText String

  /// Rupee value when applicable (DISCOUNT / CASHBACK / REFUND). Null for
  /// qualitative commitments so admin exposure totals aren't inflated by
  /// non-monetary rows.
  amountRupees Decimal? @db.Decimal(12, 2)

  /// Object key of the signed PDF in the private documents bucket. Not
  /// FK'd into the existing Document model — Documents are strongly bound
  /// to a Listing (onDelete: Cascade), and commitments may outlive or
  /// stand apart from any listing.
  documentStorageKey String
  /// SHA-256 of the signed PDF bytes at the time of signing. Any later
  /// content mutation is detectable by rehashing and comparing.
  documentHash       String  @db.Char(64)
  documentSizeBytes  Int

  /// When the promisor signed. Set at row insertion; not editable.
  signedAt       DateTime  @default(now())
  /// Optional acknowledgement by the promisee (a signed acceptance).
  acknowledgedAt DateTime?
  /// Optional expiry — a price hold typically expires in days.
  expiresAt      DateTime?
  /// Set when status flips to HONORED, DISPUTED, EXPIRED, or SUPERSEDED.
  resolvedAt     DateTime?
  /// Free text captured on resolution (dispute reason, honor notes).
  resolutionNote String?
  /// Which staff account resolved the commitment. Null for auto-expired.
  resolvedById   String? @db.Uuid

  /// Self-referential pointer set when a new commitment supersedes this one.
  supersededById String? @db.Uuid @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  promisor   User               @relation("CommitmentPromisor", fields: [promisorId], references: [id])
  promisee   User               @relation("CommitmentPromisee", fields: [promiseeId], references: [id])
  resolvedBy User?              @relation("CommitmentResolver", fields: [resolvedById], references: [id])
  supersededBy WrittenCommitment? @relation("CommitmentSuperseding", fields: [supersededById], references: [id])
  supersedes   WrittenCommitment? @relation("CommitmentSuperseding")

  @@index([promisorId, createdAt])
  @@index([promiseeId, createdAt])
  @@index([listingId])
  @@index([leadId])
  @@index([status, expiresAt])
  @@map("written_commitments")
}
