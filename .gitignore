# Dependencies
node_modules/
.pnp
.pnp.js

# Environment — NEVER commit real secrets.
#
# Deny everything matching .env* and allow back only the checked-in example.
# The previous list named each environment individually, which meant a new one
# — .env.test was the first — was silently NOT ignored and would have been
# committed along with its generated signing and encryption keys.
.env
.env.*
!.env.example

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Prisma generated client
packages/db/generated/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test / coverage
coverage/
.nyc_output/

# Local uploads (dev only — production uses object storage)
storage/
uploads/
tmp/

# Editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.recommended.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Business documents
#
# Plans and timelines are shared directly with the team, not versioned with the
# code. They are large, they change for reasons unrelated to the code, and they
# would sit in every clone forever.
/Infraproject-timeline*.pdf

# Misc
.turbo/
.cache/
